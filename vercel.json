{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "bindings": [
        {
          "type": "service",
          "service": "web-platform",
          "format": "url",
          "env": "WEB_PLATFORM_URL"
        }
      ]
    },
    "web-platform": {
      "root": "web-platform",
      "runtime": "node"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
